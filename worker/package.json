{
  "name": "figma-dom-qa-worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "bin": { "figma-dom-qa": "dist/cli.js" },
  "scripts": {
    "sync-types": "node -e \"const fs=require('fs');fs.existsSync('../shared/types.ts')&&fs.copyFileSync('../shared/types.ts','src/shared/types.ts')\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "cli": "node dist/cli.js",
    "test:e2e": "npm run build && node test/e2e.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.28.1",
    "playwright": "1.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.6.3"
  }
}
